        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Delete contact">
            <stringProp name="HTTPSampler.domain">thinking-tester-contact-list.herokuapp.com</stringProp>
